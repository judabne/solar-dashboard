# Neon PostgreSQL (required)
DATABASE_URL=

# 32-byte key as base64 or 64-char hex (required for encrypting provider credentials)
CREDENTIAL_ENCRYPTION_KEY=

# Optional pepper for device secret hashing (falls back to CREDENTIAL_ENCRYPTION_KEY)
DEVICE_HASH_SECRET=

# ShineMonitor / MUST (optional — MUST/SolarMust defaults are built in)
# SHINEMONITOR_COMPANY_KEY=
# SHINEMONITOR_APP_ID=
SHINEMONITOR_SOURCE=1
SHINEMONITOR_APP_CLIENT=web
SHINEMONITOR_APP_VERSION=1.0.0
SHINEMONITOR_I18N=en_US
SHINEMONITOR_LANG=en_US
# SolarMust web portal uses this host (not api.shinemonitor.com)
SHINEMONITOR_BASE_URL=https://web.shinemonitor.com/public/
# Set to true/false to override; web host omits _app_* params on signed API calls by default
# SHINEMONITOR_BUSINESS_USE_APP_PARAMS=

# Batali — no verified public API yet; reserved for future integration
# BATALI_API_BASE_URL=
